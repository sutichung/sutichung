# YouTube Data API v3（只放後端；用於查詢頻道目前公開直播的影片 ID）\nYOUTUBE_API_KEY=\n\n# FinMind token（僅用於歷史／基本面資料；不可作為官方即時行情來源）
FINMIND_TOKEN=

FINMIND_BASE=https://api.finmindtrade.com/api/v4/data

# Crypto WebSocket stream configuration. Feed remains disabled unless the exchange's member-display/redistribution license is confirmed.
CRYPTO_WS_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
CRYPTO_WS_ENABLE_FUTURES=false
CRYPTO_WS_STALE_MS=30000
BINANCE_MARKET_DATA_LICENSE_CONFIRMED=false
BYBIT_MARKET_DATA_LICENSE_CONFIRMED=false
OKX_MARKET_DATA_LICENSE_CONFIRMED=false
COINBASE_MARKET_DATA_LICENSE_CONFIRMED=false
KRAKEN_MARKET_DATA_LICENSE_CONFIRMED=false
KRAKEN_FUTURES_MARKET_DATA_LICENSE_CONFIRMED=false

# 台股官方公開日行情由 TWSE OpenAPI + TPEx OpenAPI 取得；此資料為收盤／日資料，不是盤中即時 feed。
# 即時逐筆／即時報價需另行申請交易所或核准資訊商授權，不可將日資料標示為即時。
PORT=8787

# 以下 URL 指向你購買／自行架設且已授權的 JSON API
# 未設定時系統會顯示資料不足，不會產生假行情
# Optional licensed real-time feeds: endpoint and explicit exchange license confirmation are both required.
TWSE_REALTIME_PROVIDER_URL=
TWSE_REALTIME_LICENSE_CONFIRMED=false
TPEX_REALTIME_PROVIDER_URL=
TPEX_REALTIME_LICENSE_CONFIRMED=false

MARKET_SCAN_URL=
MARKET_FLOWS_URL=
MARKET_FUTURES_URL=
MARKET_SENTIMENT_URL=
MARKET_NEWS_URL=


VITE_MARKET_API=/api/market

# 前端建置時可加入經授權的 HLS 直播來源（JSON 陣列；公開串流 URL，不可放 API Secret）
VITE_LIVE_HLS_STREAMS=[]

# Supabase 會員系統（所有憑證只放伺服器端；Secret key 不可提交）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ADMIN_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional global intelligence providers (never commit secret values)
FRED_API_KEY=
WHALE_ALERT_API_URL=
WHALE_ALERT_API_KEY=

