# YouTube Data API v3（只放後端；用於查詢頻道目前公開直播的影片 ID）\nYOUTUBE_API_KEY=\n\n# FinMind token（只放後端，勿提交真實 Token）
FINMIND_TOKEN=

# Fugle 台股行情 API Key（上市＋上櫃全市場快照；上游每 5 秒更新）
FUGLE_API_KEY=
FUGLE_BASE_URL=https://api.fugle.tw/marketdata/v1.0/stock
FINMIND_BASE=https://api.finmindtrade.com/api/v4/data
PORT=8787

# 以下 URL 指向你購買／自行架設且已授權的 JSON API
# 未設定時系統會顯示資料不足，不會產生假行情
MARKET_REALTIME_URL=
MARKET_SCAN_URL=
MARKET_FLOWS_URL=
MARKET_FUTURES_URL=
MARKET_SENTIMENT_URL=
MARKET_NEWS_URL=

# 三 AI 個股分析（原廠 API 可選；API Key 僅放 Render 後端）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
XAI_API_KEY=
XAI_MODEL=grok-4.7
DEEPSEEK_API_KEY=
# DeepSeek API（若無 API Key，可由下方 OpenRouter 免費模型備援）
DEEPSEEK_MODEL=deepseek-flash

# AI 備援：OpenRouter 免費模型路由（單一 Key 共用三個獨立 Agent；免費模型供應可能變動）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional: pin different free model IDs for each independent analysis role
OPENROUTER_GEMINI_MODEL=
OPENROUTER_GROK_MODEL=
OPENROUTER_DEEPSEEK_MODEL=
OPENROUTER_SITE_URL=https://taiwan-stock-hunter-o3tt.onrender.com

VITE_MARKET_API=/api/market

# 前端建置時可加入經授權的 HLS 直播來源（JSON 陣列；公開串流 URL，不可放 API Secret）
VITE_LIVE_HLS_STREAMS=[]

# Supabase 會員系統（所有憑證只放伺服器端；Secret key 不可提交）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ADMIN_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
